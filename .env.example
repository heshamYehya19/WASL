# Copy this file to `.env` and fill in what you need. `.env` is git-ignored and must never be committed.
# Nothing here is required to start WASL: without a key, challenge generation falls back to a clearly
# labelled template, and the review / interview / assessment steps report "assessment unavailable".

# ── AI providers ────────────────────────────────────────────────────────────────────────────────
# Groq is tried first. Create a key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional. Default: openai/gpt-oss-120b
GROQ_MODEL=

# Gemini is the backup when Groq is rate-limited or down. Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Default: gemini-flash-latest
GEMINI_MODEL=

# Optional: "groq" or "gemini" — which provider to try first when both keys are set.
WASL_AI_PROVIDER=
# Optional: per-request timeout in milliseconds. Default: 45000
WASL_AI_TIMEOUT_MS=

# ── GitHub ──────────────────────────────────────────────────────────────────────────────────────
# Optional. Raises the GitHub API rate limit when reading candidates' public repositories.
# A token with NO scopes is enough; it is only ever sent to api.github.com.
GITHUB_TOKEN=

# ── Server ──────────────────────────────────────────────────────────────────────────────────────
PORT=3000
# Where the SQLite database lives. Default: data/wasl.db
WASL_DB_PATH=
# "false" disables the demo account switcher, demo sign-up and the reset endpoint.
# The demo sign-in (an X-WASL-Actor header) is NOT production authentication — see the README.
WASL_DEMO_MODE=true
# "false" starts with an empty database instead of the labelled demonstration data.
WASL_SEED_DEMO_DATA=true

# ── Development and tests only ──────────────────────────────────────────────────────────────────
# Point a provider at a local mock (the end-to-end tests do this). Leave empty in real use.
WASL_GROQ_BASE_URL=
WASL_GEMINI_BASE_URL=
# "true" = demo mock AI for local presentation rehearsal: scripted answers, no AI provider is contacted (no quota used),
# and everything it produces is labelled as demonstration data. Off when empty. Refused (the server won't start) with
# NODE_ENV=production or WASL_DEMO_MODE=false. Never set it in a real deployment.
WASL_AI_MOCK=
